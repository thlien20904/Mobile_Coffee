{
  "expo": {
    "name": "SuLiCoffee",
    "slug": "SuLiCoffee",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Ứng dụng cần vị trí để hiển thị cửa hàng gần bạn.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Ứng dụng cần vị trí để hiển thị cửa hàng gần bạn."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "package": "com.testx.app"
    },
    "web": {
      "favicon": "./assets/logo.png"
    },
    "scheme": "testx"
  }
}